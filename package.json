{
  "name": "bestphoto",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --publish never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "exifr": "^7.1.3"
  },
  "productName": "BestPhoto",
  "build": {
    "directories": {
      "output": "release"
    },
    "appId": "com.artmedev.bestphoto",
    "productName": "BestPhoto",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "dist/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/**",
      "node_modules/sharp/**",
      "node_modules/@img/**"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**"
      ]
    },
    "portable": {
      "artifactName": "BestPhoto.exe"
    },
    "mac": {
      "target": "dmg",
      "identity": null,
      "category": "public.app-category.photography",
      "artifactName": "BestPhoto-mac.${ext}",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/linux/**"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Graphics",
      "artifactName": "BestPhoto-linux.${ext}",
      "files": [
        "!node_modules/onnxruntime-node/bin/napi-v*/win32/**",
        "!node_modules/onnxruntime-node/bin/napi-v*/darwin/**"
      ]
    },
    "rpm": {
      "fpm": [
        "--rpm-rpmbuild-define=_build_id_links none"
      ]
    }
  },
  "author": {
    "name": "artmedev",
    "email": "artmedev@users.noreply.github.com"
  },
  "homepage": "https://github.com/artmedev/bestphoto"
}
